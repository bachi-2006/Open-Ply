# ========================================================
# 🛡️ SentinelFlow Environment Configuration
# ========================================================

# 1. Google Gemini API Key (Recommended for SentinelFlow)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Selected Model (Default: google/gemini-3.8-flash)
# Options:
# - google/gemini-3.8-flash (Recommended)
# - google/gemini-3.6-flash
# - google/gemini-2.5-flash
# - google/gemini-2.5-pro
GEMINI_MODEL=google/gemini-3.8-flash

# 3. Optional: OpenRouter API Key (Fallback for other models)
OPENROUTER_API_KEY=

# 4. Workspace Root (Defaults to monorepo root)
OPENPLY_ROOT=.
